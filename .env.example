BETTER_AUTH_URL=http://127.0.0.1:3000
BETTER_AUTH_SECRET=replace-with-a-random-secret-of-at-least-32-characters
DATABASE_URL=postgresql://mendwire:replace-with-local-password@127.0.0.1:5432/mendwire?schema=public
SMTP_HOST=127.0.0.1
SMTP_PORT=10255
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=false
SMTP_FROM=Mendwire <no-reply@localhost>

# Versioned beta access policy overrides (defaults are provisional technical caps).
MENDWIRE_BETA_ACTIVE_MONITORS=3
MENDWIRE_BETA_CHECK_FREQUENCY_HOURS=24
MENDWIRE_BETA_ANALYSES_PER_MONTH=10
MENDWIRE_BETA_PROPOSALS_PER_MONTH=5
MENDWIRE_MANUAL_CHECK_COOLDOWN_SECONDS=300

# Optional comma-separated user IDs for bounded owner testing of the user's own workspace.
# This grants no access to customer workspaces and must remain private server configuration.
MENDWIRE_OWNER_USER_IDS=

# Demo API stays disabled until an explicit revision is selected.
MENDWIRE_DEMO_API_REVISION=
MENDWIRE_DEMO_API_ORIGIN=http://127.0.0.1:3000
