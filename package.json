{
  "name": "mendwire",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24 <27"
  },
  "scripts": {
    "dev": "next dev --webpack --hostname 127.0.0.1",
    "build": "next build --webpack",
    "start": "next start --hostname 127.0.0.1",
    "preview": "npm run build && npm run start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:studio": "prisma studio --browser none",
    "worker:monitoring": "node --env-file-if-exists=.env --conditions=react-server --import tsx scripts/monitor-worker.ts",
    "install:oasdiff": "node scripts/install-oasdiff.mjs"
  },
  "dependencies": {
    "@better-auth/prisma-adapter": "1.7.14",
    "@fontsource-variable/ibm-plex-sans": "5.3.0",
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@heroui/react": "3.2.6",
    "@heroui/styles": "3.2.7",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "better-auth": "1.7.14",
    "clsx": "2.1.1",
    "js-yaml": "4.3.2",
    "lucide-react": "1.67.0",
    "motion": "14.9.0",
    "next": "16.4.2",
    "nodemailer": "10.3.1",
    "pg": "8.16.3",
    "pg-boss": "12.38.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "tailwind-merge": "3.7.0",
    "typescript": "5.9.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.10.0",
    "@types/pg": "8.15.5",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.2",
    "postcss": "8.5.6",
    "prisma": "7.10.1",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "vitest": "4.1.12"
  },
  "allowScripts": {}
}
